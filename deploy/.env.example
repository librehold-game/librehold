# Copy to deploy/.env and fill in. The file is read by docker compose and passed to the server.

# Database password, used by the db, server and backup services. The database is reachable only by the
# other services, never from outside.
POSTGRES_PASSWORD=change-me
LH_DATABASE_URL=postgres://librehold:change-me@db:5432/librehold?sslmode=disable

# Valkey keeps the limits on logins, new accounts and reports, shared by every server process. It is reachable only
# by the other services.
VALKEY_PASSWORD=change-me-too
LH_VALKEY_URL=redis://:change-me-too@valkey:6379/0

# The admin account created on the first start (only when there is no admin yet).
# 3–24 characters of A–Z a–z 0–9 _ -, and a password of at least 8 characters.
LH_ADMIN_USERNAME=admin
LH_ADMIN_PASSWORD=

# Where the game listens on this machine: http://<address>:<port>/
LH_BIND=0.0.0.0
LH_PORT=8080

# Plain HTTP (the default): cookies without Secure, client addresses taken from the connection.
LH_COOKIE_SECURE=false

# HTTPS through Caddy instead (docker compose --profile https up -d): set the domain, make cookies Secure and keep
# the plain port off the network so nobody can go around Caddy. The server already trusts X-Forwarded-For from
# Caddy's address in docker-compose.yml; set LH_TRUSTED_PROXIES only for another proxy.
# LH_DOMAIN=play.example.org
# LH_COOKIE_SECURE=true
# LH_BIND=127.0.0.1
# The site's own address for canonical links, link previews and the sitemap.
# LH_PUBLIC_URL=https://play.example.org
